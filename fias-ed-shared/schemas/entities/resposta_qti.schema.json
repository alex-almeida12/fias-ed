{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fias-ed.local/schemas/entities/resposta_qti.schema.json",
  "title": "RespostaQTI",
  "allOf": [{"$ref": "_base.schema.json"}, {
    "type": "object",
    "required": ["questionario_qti_id", "answers"],
    "properties": {
      "questionario_qti_id": {"type": "string", "format": "uuid"},
      "answers": {
        "type": "object",
        "minProperties": 24,
        "maxProperties": 24,
        "patternProperties": {
          "^([1-9]|1[0-9]|2[0-4])$": {"type": "integer", "minimum": 1, "maximum": 5}
        },
        "additionalProperties": false
      },
      "ocr_confidence": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }],
  "unevaluatedProperties": false
}
