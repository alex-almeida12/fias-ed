{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fias-ed.local/schemas/entities/classificacao_fias.schema.json",
  "title": "ClassificacaoFIAS",
  "allOf": [{"$ref": "_base.schema.json"}, {
    "type": "object",
    "required": ["segmento_id", "transcript_source", "pred_raw", "pred_role_constrained", "confidence_raw", "confidence", "uncertain", "model_id", "rules_version"],
    "properties": {
      "segmento_id": {"type": "string", "format": "uuid"},
      "transcript_source": {"enum": ["ASR_ORIGINAL", "TRANSCRICAO_REVISADA"]},
      "pred_raw": {"type": "integer", "minimum": 1, "maximum": 10},
      "pred_role_constrained": {"type": "integer", "minimum": 1, "maximum": 10},
      "confidence_raw": {"type": "number", "minimum": 0, "maximum": 1},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "uncertain": {"type": "boolean"},
      "model_id": {"type": "string"},
      "rules_version": {"type": "string"}
    }
  }],
  "unevaluatedProperties": false
}
