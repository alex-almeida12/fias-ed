{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fias-ed.local/schemas/entities/falante.schema.json",
  "title": "Falante",
  "allOf": [{"$ref": "_base.schema.json"}, {
    "type": "object",
