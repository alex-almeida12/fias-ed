# Copie para .env e troque TODAS as senhas (use valores longos e aleatórios,
# só com letras, números, - e _: elas entram nas URLs de conexão do banco).
POSTGRES_PASSWORD=troque-esta-senha-do-superusuario
FIAS_ED_MIGRATOR_PASSWORD=troque-esta-senha-do-migrator
FIAS_ED_APP_PASSWORD=troque-esta-senha-da-aplicacao
DEVICE_ID=fias-ed-web
# MAX_UPLOAD_BYTES e client_max_body_size em deploy/nginx.conf (1536m) mudam JUNTOS;
# depois de mudar o nginx, reconstrua: docker compose up -d --build web
MAX_UPLOAD_BYTES=1610612736
MIN_AUDIO_SECONDS=60
MAX_AUDIO_SECONDS=9000
# Diretório dos pesos (fora do Git). Populado por scripts/setup_models.py.
FIAS_ED_MODELS_DIR=/models
# Tamanho do modelo de ASR: tiny, base ou small (ver a tabela de medição no README).
FIAS_ED_ASR_SIZE=small
# Execução offline: nenhuma chamada de rede em tempo de execução.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
